NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ssms_dev
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173
# Set true behind HTTPS (default true in production)
COOKIE_SECURE=false
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_MIN=15
RESET_TOKEN_TTL_MIN=30
# Used only by `pnpm bootstrap:admin`
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator
